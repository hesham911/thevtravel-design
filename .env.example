# Public, non-secret frontend configuration. Leave blank for existing demo mode.
# Fallback only: the WhatsApp address is managed in the admin under
# Settings → Social, and every "Chat on WhatsApp" button stays disabled
# while neither is set.
NUXT_PUBLIC_WHATSAPP_URL=
NUXT_PUBLIC_LOCATION_API_URL=
# Laravel public API root, e.g. http://thevtravel-backend.test/api/public.
# Every CMS-managed page loads its content from it — the home page, the
# journeys, About, FAQ, Contact, How Booking Works, the legal pages and the
# header and footer every page shares. Leave blank to keep serving each
# page's built-in demo copy.
NUXT_PUBLIC_API_BASE_URL=
# Set the real deployment origin to enable absolute canonical and OG URLs.
NUXT_PUBLIC_SITE_URL=
# Optional OpenMapTiles-compatible vector style. OpenFreeMap default needs no key.
NUXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
